<Window x:Class="TitaniumLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TitaniumLauncher"
        xmlns:controls="clr-namespace:TitaniumLauncher.Controls"
        Title="Titanium Launcher"
        Width="1280" Height="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize"
        Icon="Assets/titanium.ico"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseSettingsCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{StaticResource DimTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Found">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasBuildWarning}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Detecting">
                    <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Problem">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProfileDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{StaticResource DimTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasProfile}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SeasonWheel" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <controls:RadialPanel Radius="205" Diameter="520" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeasonWheelItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="92" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Glow" CornerRadius="17" Background="#003BD9FF" />
                            <Border x:Name="Bd" CornerRadius="15" BorderBrush="#24FFFFFF" BorderThickness="1"
                                    Background="#0A1A27">
                                <ContentPresenter Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#663BD9FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Glow" Property="Background" Value="#253BD9FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CC3BD9FF" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3BD9FF" BlurRadius="18" ShadowDepth="0" Opacity="0.35" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SeasonTile">
            <Grid ToolTip="{Binding AvailabilityNote}" AutomationProperties.Name="{Binding Name}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReleased}" Value="False">
                                <Setter Property="Opacity" Value="0.7" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border CornerRadius="12" Background="{Binding CoverBrush}" />
                <Border CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#59000000" Offset="0" />
                            <GradientStop Color="#B8000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Rectangle Fill="{StaticResource FineGridBrush}" Opacity="0.35" IsHitTestVisible="False" />
                <Grid Margin="8,7,8,7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="S E A S O N" FontSize="6" FontWeight="Bold" Foreground="#AFC7D3" HorizontalAlignment="Center" />
                    <TextBlock Grid.Row="1" Text="{Binding Code}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="29" FontWeight="Bold" FontStyle="Italic" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="{Binding ReleaseLabel}" FontSize="6.2" FontWeight="Bold"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#8093A0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReleased}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Border CornerRadius="16" Background="#000000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.6" Color="Black" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="16" Background="#050D15" BorderBrush="#2AFFFFFF" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="178" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ======================= SIDEBAR ======================= -->
                <Border Grid.Column="0" CornerRadius="15,0,0,15" BorderBrush="#12FFFFFF" BorderThickness="0,0,1,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#091724" Offset="0" />
                            <GradientStop Color="#050D15" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Rectangle Fill="{StaticResource FineGridBrush}" Opacity="0.3" IsHitTestVisible="False" />
                        <Grid Margin="14,16,14,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Width="56" Height="56" CornerRadius="13" Background="#0A1F2C"
                                        BorderBrush="#3A9BC0" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#20B8E6" BlurRadius="18" ShadowDepth="0" Opacity="0.28" />
                                    </Border.Effect>
                                    <Image Source="Assets/logo.png" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                                <TextBlock Text="M E N U" FontSize="8" FontWeight="Bold"
                                           Foreground="#5C7787" Margin="16,0,0,9" />

                                <Button Style="{StaticResource NavButton}" Content="Home"
                                        Tag="&#xE80F;" ui:Ui.Active="{Binding IsHomeScreen}" Command="{Binding HomeCommand}"
                                        AutomationProperties.Name="Home" />
                                <Button Style="{StaticResource NavButton}" Content="Play"
                                        Tag="&#xE768;" Command="{Binding PlayCommand}"
                                        ToolTip="{Binding PlayHint}" ToolTipService.ShowOnDisabled="True"
                                        AutomationProperties.Name="Play" />
                                <Button Style="{StaticResource NavButton}" Content="Game files"
                                        Tag="&#xE838;" Command="{Binding BrowseCommand}"
                                        ToolTip="Choose the Fortnite build folder"
                                        AutomationProperties.Name="Game files" />
                                <Button Style="{StaticResource NavButton}" Content="Settings"
                                        Tag="&#xE713;" Command="{Binding ToggleSettingsCommand}"
                                        AutomationProperties.Name="Settings" />
                                <Border Height="1" Background="#12FFFFFF" Margin="13,9,13,10" />
                                <Button Style="{StaticResource NavButton}" Content="Discord"
                                        Tag="&#xE8BD;" Command="{Binding OpenCommunityCommand}"
                                        ToolTip="Join the Titanium Discord"
                                        AutomationProperties.Name="Discord" />
                                <Button Style="{StaticResource NavButton}" Content="Support"
                                        Tag="&#xE897;" Command="{Binding OpenCommunityCommand}"
                                        ToolTip="Get support in the Titanium Discord"
                                        AutomationProperties.Name="Support" />
                                <Button Style="{StaticResource NavButton}" Content="Credits"
                                        Tag="&#xE716;" ui:Ui.Active="{Binding IsCreditsScreen}"
                                        Command="{Binding OpenCreditsCommand}"
                                        ToolTip="Meet the people behind Titanium"
                                        AutomationProperties.Name="Credits" />
                            </StackPanel>

                            <Border Grid.Row="3" Height="168" CornerRadius="11" ClipToBounds="True"
                                    BorderBrush="#2A5E7887" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#123245" Offset="0" />
                                        <GradientStop Color="#07131E" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Image Source="Assets/og-card.png" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Rectangle IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#9905111A" Offset="0" />
                                                <GradientStop Color="#3305111A" Offset="0.5" />
                                                <GradientStop Color="#0005111A" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Grid Margin="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="15" FontWeight="Bold" FontStyle="Italic"
                                                       LineHeight="15" Foreground="#FFFFFF" Text="PLAY&#10;THE OG&#10;WAY." />
                                            <Border Width="20" Height="2" Background="{StaticResource AccentBrush}"
                                                    HorizontalAlignment="Left" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="4" Margin="3,10,3,0">
                                <TextBlock Text="{Binding LauncherVersionText}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="#8FA9B7" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ======================= MAIN ======================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                            <TextBlock Text="TITANIUM" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                       FontWeight="Bold" FontStyle="Italic" Foreground="{StaticResource TextBrush}" />
                            <Border Width="1" Height="16" Background="#26FFFFFF" Margin="12,1,12,0" />
                            <TextBlock Text="R E S T O R A T I O N   P R O J E C T" FontSize="8"
                                       FontWeight="SemiBold" Foreground="#718C9B" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,11,0">
                            <Button Style="{StaticResource WindowButton}" Click="Minimize_Click"
                                    ToolTip="Minimize" AutomationProperties.Name="Minimize"
                                    Content="&#xE921;" />
                            <Button Style="{StaticResource CloseWindowButton}" Click="Close_Click" Margin="3,0,0,0"
                                    ToolTip="Close" AutomationProperties.Name="Close"
                                    Content="&#xE8BB;" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="24,0,24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="136" />
                        </Grid.RowDefinitions>

                        <!-- ======================= HERO ======================= -->
                        <Border Grid.Row="0" CornerRadius="12" BorderBrush="#24FFFFFF" BorderThickness="1"
                                ClipToBounds="True"
                                Visibility="{Binding IsHomeScreen, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="Assets/ice-bg.jpg" Stretch="UniformToFill" Opacity="0.8" />
                            </Border.Background>
                            <Grid>
                                <Image Source="{Binding ActiveSeason.BackgroundImage}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
                                <Rectangle IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSeasonBackground}" Value="True">
                                                    <Setter Property="Opacity" Value="0.62" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F207121C" Offset="0" />
                                            <GradientStop Color="#E607121C" Offset="0.34" />
                                            <GradientStop Color="#8507131D" Offset="0.63" />
                                            <GradientStop Color="#B207121B" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle IsHitTestVisible="False">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSeasonBackground}" Value="True">
                                                    <Setter Property="Opacity" Value="0.58" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#B3040C14" Offset="0" />
                                            <GradientStop Color="#0F040C14" Offset="0.36" />
                                            <GradientStop Color="#D1030B12" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Ellipse Width="520" Height="380" HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Margin="-60,-90,0,0" IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#1A2C7A93" Offset="0" />
                                            <GradientStop Color="#002C7A93" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Rectangle Fill="{StaticResource DotFieldBrush}" Opacity="0.55" IsHitTestVisible="False" />

                                <!-- Stylised frozen monolith + emblem -->
                                <Viewbox Stretch="Uniform" Width="760" Height="440" HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom" Margin="0,0,0,-2" IsHitTestVisible="False">
                                    <Viewbox.Style>
                                        <Style TargetType="Viewbox">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSeasonBackground}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Viewbox.Style>
                                    <Canvas Width="760" Height="460">
                                        <Ellipse Canvas.Left="150" Canvas.Top="26" Width="380" Height="380">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#553BD9FF" Offset="0" />
                                                    <GradientStop Color="#223BD9FF" Offset="0.45" />
                                                    <GradientStop Color="#003BD9FF" Offset="1" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Rectangle Canvas.Left="282" Canvas.Top="0" Width="130" Height="430" Opacity="0.5">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#003BD9FF" Offset="0" />
                                                    <GradientStop Color="#183BD9FF" Offset="0.44" />
                                                    <GradientStop Color="#003BD9FF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Ellipse Canvas.Left="178" Canvas.Top="54" Width="326" Height="326"
                                                 Stroke="#2E8DA8" StrokeThickness="1" Opacity="0.45" />
                                        <Ellipse Canvas.Left="206" Canvas.Top="82" Width="270" Height="270"
                                                 Stroke="#4BBAD4" StrokeThickness="1" StrokeDashArray="1,6"
                                                 Opacity="0.5" />
                                        <Ellipse Canvas.Left="238" Canvas.Top="114" Width="206" Height="206"
                                                 Stroke="#63D8EE" StrokeThickness="1" Opacity="0.28" />
                                        <Path Stroke="#5FD9F2" StrokeThickness="1.5" Opacity="0.55"
                                              Data="M 183,299 A 200,200 0 0 1 405,117" />
                                        <Path Stroke="#5FD9F2" StrokeThickness="1" Opacity="0.25"
                                              Data="M 500,160 A 190,190 0 0 1 553,310" />
                                        <Ellipse Canvas.Left="196" Canvas.Top="352" Width="300" Height="42" Opacity="0.7">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#663BD9FF" Offset="0" />
                                                    <GradientStop Color="#003BD9FF" Offset="1" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Path Fill="#0C2A3C" Opacity="0.92"
                                              Data="M0,460 L0,386 L56,348 L104,376 L166,312 L218,360 L284,330 L346,378 L414,296 L468,350 L536,314 L606,368 L674,326 L760,376 L760,460 Z" />
                                        <Path Fill="#081E2C"
                                              Data="M0,460 L0,416 L66,390 L128,412 L196,362 L252,408 L318,378 L390,418 L452,370 L520,404 L590,378 L660,416 L760,386 L760,460 Z" />
                                        <Path Fill="#05131D"
                                              Data="M604,436 L604,368 L611,368 L611,356 L618,356 L618,344 L625,344 L625,334 L632,334 L632,344 L639,344 L639,356 L646,356 L646,368 L653,368 L653,436 Z" />
                                        <Rectangle Canvas.Left="626" Canvas.Top="348" Width="4" Height="8"
                                                   Fill="#3BD9FF" Opacity="0.45" />
                                        <Path Fill="#061520"
                                              Data="M0,460 L0,442 L110,430 L190,446 L280,422 L370,446 L470,428 L560,446 L660,432 L760,448 L760,460 Z" />
                                        <Image Canvas.Left="252" Canvas.Top="126" Width="176" Height="176"
                                               Source="Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality"
                                               RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <RotateTransform Angle="-7" />
                                            </Image.RenderTransform>
                                        </Image>
                                        <Path Canvas.Left="452" Canvas.Top="150" Fill="#123C50" Opacity="0.85"
                                              Data="M 10,0 L 20,22 L 10,44 L 0,22 Z">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="18" />
                                            </Path.RenderTransform>
                                        </Path>
                                        <Path Canvas.Left="566" Canvas.Top="104" Fill="#16465C" Opacity="0.8"
                                              Data="M 5,0 L 10,10 L 5,20 L 0,10 Z" />
                                        <Path Canvas.Left="170" Canvas.Top="120" Fill="#16465C" Opacity="0.6"
                                              Data="M 4,0 L 8,8 L 4,16 L 0,8 Z" />
                                        <Ellipse Canvas.Left="210" Canvas.Top="118" Width="2" Height="2" Fill="#BDEFFF" Opacity="0.75" />
                                        <Ellipse Canvas.Left="500" Canvas.Top="90" Width="3" Height="3" Fill="#BDEFFF" Opacity="0.55" />
                                        <Ellipse Canvas.Left="540" Canvas.Top="260" Width="2" Height="2" Fill="#BDEFFF" Opacity="0.55" />
                                        <Ellipse Canvas.Left="160" Canvas.Top="300" Width="2" Height="2" Fill="#BDEFFF" Opacity="0.45" />
                                        <Ellipse Canvas.Left="470" Canvas.Top="210" Width="2" Height="2" Fill="#BDEFFF" Opacity="0.65" />
                                        <Ellipse Canvas.Left="610" Canvas.Top="150" Width="2" Height="2" Fill="#BDEFFF" Opacity="0.45" />
                                    </Canvas>
                                </Viewbox>

                                <!-- Hero copy -->
                                <StackPanel Width="440" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Margin="36,24,0,24">
                                    <Border HorizontalAlignment="Left" Padding="11,4,18,4"
                                            Background="{StaticResource AccentGradient}" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <SkewTransform AngleX="-10" />
                                        </Border.RenderTransform>
                                        <TextBlock Text="WELCOME TO" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="10" FontWeight="Bold" Foreground="#03212B"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <SkewTransform AngleX="10" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Border>

                                    <TextBlock Text="TITANIUM" FontFamily="{StaticResource DisplayFont}" FontSize="73"
                                               FontWeight="Bold" FontStyle="Italic" LineHeight="66"
                                               Margin="0,9,0,0">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFFFFF" Offset="0" />
                                                <GradientStop Color="#D7F4FF" Offset="0.62" />
                                                <GradientStop Color="#9BD9ED" Offset="1" />
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" Margin="3,-8,0,0">
                                        <TextBlock Text="LAUNCHER" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="31" FontWeight="Bold" FontStyle="Italic"
                                                   Foreground="{StaticResource AccentSoftBrush}"
                                                   RenderTransformOrigin="0,0.5">
                                            <TextBlock.RenderTransform>
                                                <SkewTransform AngleX="-8" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <Border Width="42" Height="2" Background="{StaticResource AccentBrush}"
                                                VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8" />
                                    </StackPanel>

                                    <TextBlock FontSize="11.5" Foreground="#A9C0CC" LineHeight="18.5" Margin="2,11,0,0">
                                        <Run Text="RELIVE THE ORIGINAL." />
                                        <LineBreak />
                                        <Run Text="PLAY FOREVER." Foreground="#7C97A5" />
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" Margin="2,15,0,0">
                                        <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Center" />
