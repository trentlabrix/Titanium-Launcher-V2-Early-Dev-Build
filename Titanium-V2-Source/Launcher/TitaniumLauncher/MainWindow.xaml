                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding ModeLabel}" FontSize="9.5"
                                                                           Foreground="{StaticResource DimTextBrush}"
                                                                           Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                                    Width="24" Height="24"
                                                                    Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Delete profile" AutomationProperties.Name="Delete profile">
                                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="NEW PROFILE MODE" Style="{StaticResource SettingsSection}" Margin="0,16,0,4" />
                                            <TextBlock Text="Choose how this save starts. Each mode keeps its own separate save."
                                                       Style="{StaticResource SettingsHint}" Margin="0,0,0,10" />
                                            <RadioButton GroupName="ProfileMode" Style="{StaticResource ModeRadio}"
                                                         IsChecked="{Binding NewProfileIsProgression, Mode=TwoWay}">
                                                <StackPanel>
                                                    <TextBlock Text="Progression Mode" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftBrush}" />
                                                    <TextBlock Text="Progression Mode is for users who want to feel that Nostalgic grinding feeling again. You start at level 0, tier 0. You can complete challenges and work your way through the battle pass"
                                                               TextWrapping="Wrap" Foreground="{StaticResource DimTextBrush}"
                                                               FontSize="10.5" LineHeight="15" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton GroupName="ProfileMode" Style="{StaticResource ModeRadio}"
                                                         IsChecked="{Binding NewProfileIsUnlockedAll, Mode=TwoWay}">
                                                <StackPanel>
                                                    <TextBlock Text="Unlocked All" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftBrush}" />
                                                    <TextBlock Text="Unlock All is for users who want to enjoy the classic game but be able to use all cosmetics"
                                                               TextWrapping="Wrap" Foreground="{StaticResource DimTextBrush}"
                                                               FontSize="10.5" LineHeight="15" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </RadioButton>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid>
                                                    <TextBox x:Name="NameBox" Style="{StaticResource GlassTextBox}" MaxLength="16"
                                                             Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Player name">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Return" Command="{Binding CreateProfileCommand}" />
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <TextBlock Text="Player name" IsHitTestVisible="False" FontSize="12.5"
                                                               Margin="13,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{StaticResource DimTextBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Button Grid.Column="2" Content="CREATE" Style="{StaticResource PrimaryButton}"
                                                        Command="{Binding CreateProfileCommand}" MinWidth="82" />
                                            </Grid>
                                            <TextBlock Text="{Binding ProfileError}" Margin="0,6,0,0" FontSize="10"
                                                       TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                                                       Visibility="{Binding HasProfileError, Converter={StaticResource BoolToVis}}" />

                                            <Border Height="1" Background="#12FFFFFF" Margin="0,18,0,18" />

                                            <TextBlock Text="BOT DIFFICULTY" Style="{StaticResource SettingsSection}" />
                                            <TextBlock Text="{Binding DifficultyName}" FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="17" FontWeight="Bold" FontStyle="Italic"
                                                       Foreground="{StaticResource AccentSoftBrush}" Margin="0,7,0,0" />
                                            <Slider Style="{StaticResource IceSlider}" Minimum="0" Maximum="5"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1"
                                                    LargeChange="1" Margin="0,5,0,0"
                                                    Value="{Binding DifficultyIndex, Mode=TwoWay}"
                                                    AutomationProperties.Name="Bot difficulty" />
                                            <UniformGrid Columns="6" Margin="0,1,0,7">
                                                <Button Content="Trash" Style="{StaticResource LinkButton}" FontSize="9.5"
                                                        Command="{Binding SetDifficultyCommand}" CommandParameter="0" />
                                                <Button Content="Easy" Style="{StaticResource LinkButton}" FontSize="9.5"
                                                        Command="{Binding SetDifficultyCommand}" CommandParameter="1" />
                                                <Button Content="Medium" Style="{StaticResource LinkButton}" FontSize="9.5"
                                                        Command="{Binding SetDifficultyCommand}" CommandParameter="2" />
                                                <Button Content="Hard" Style="{StaticResource LinkButton}" FontSize="9.5"
                                                        Command="{Binding SetDifficultyCommand}" CommandParameter="3" />
                                                <Button Content="Sweat" Style="{StaticResource LinkButton}" FontSize="9.5"
                                                        Command="{Binding SetDifficultyCommand}" CommandParameter="4" />
                                                <Button Content="Mixed" Style="{StaticResource LinkButton}" FontSize="9.5"
                                                        Command="{Binding SetDifficultyCommand}" CommandParameter="5" />
                                            </UniformGrid>
                                            <TextBlock Text="{Binding DifficultyDescription}" Style="{StaticResource SettingsHint}" />

                                            <TextBlock Text="PRESETS" Style="{StaticResource SettingsSection}" Margin="0,18,0,0" />
                                            <TextBlock Text="Saved difficulty" Style="{StaticResource SettingsHint}" Margin="0,4,0,5" />
                                            <ComboBox Style="{StaticResource DarkComboBox}"
                                                      ItemsSource="{Binding DifficultyPresets}"
                                                      SelectedItem="{Binding SelectedDifficultyPreset}"
                                                      AutomationProperties.Name="Saved difficulty preset">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                            <TextBlock Text="Preset name" Style="{StaticResource SettingsHint}" Margin="0,10,0,4" />
                                            <TextBox Style="{StaticResource GlassTextBox}"
                                                     Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="60" Margin="0,0,0,18"
                                                     AutomationProperties.Name="Preset name" />
                                            <WrapPanel Margin="0,9,0,0">
                                                <Button Content="SAVE" Style="{StaticResource PrimaryButton}"
                                                        Command="{Binding SavePresetCommand}" Margin="0,0,7,7" />
                                                <Button Content="IMPORT .FNP" Style="{StaticResource PrimaryButton}"
                                                        Command="{Binding ImportPresetCommand}" Margin="0,0,7,7" />
                                                <Button Content="EXPORT .FNP" Style="{StaticResource PrimaryButton}"
                                                        Command="{Binding ExportPresetCommand}" Margin="0,0,0,7" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding PresetStatus}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource AccentSoftBrush}" FontSize="9.5"
                                                       Margin="0,0,0,4" />

                                            <Expander Style="{StaticResource DarkExpander}" FontSize="11.5"
                                                      Header="Customize 20 bot skills" Margin="0,10,0,0"
                                                      IsExpanded="False">
                                                <ItemsControl ItemsSource="{Binding SkillSliders}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,10,0,4">
                                                                <DockPanel>
                                                                    <TextBlock Text="{Binding Value}" DockPanel.Dock="Right"
                                                                               Foreground="{StaticResource AccentSoftBrush}"
                                                                               HorizontalAlignment="Right" FontSize="10.5" />
                                                                    <TextBlock Text="{Binding Definition.Name}"
                                                                               Foreground="{StaticResource TextBrush}"
                                                                               FontWeight="SemiBold" FontSize="11" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Definition.Description}"
                                                                           Style="{StaticResource SettingsHint}"
                                                                           FontSize="9" Margin="0,2,0,3" />
                                                                <Slider Style="{StaticResource IceSlider}" Minimum="0" Maximum="100"
                                                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                                                        Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        AutomationProperties.Name="{Binding Definition.Name}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>

                                            <Border Background="#0B2231" CornerRadius="6" Padding="10,7"
                                                    BorderBrush="#1C3BD9FF" BorderThickness="1" Margin="0,16,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="AI" FontFamily="{StaticResource DisplayFont}"
                                                               FontWeight="Bold" FontSize="10"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                    <TextBlock Text="TITANIUM" FontFamily="{StaticResource DisplayFont}"
                                                               FontWeight="Bold" FontSize="10" Margin="4,0,0,0"
                                                               Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="built-in bot brain" FontSize="8.5"
                                                               Foreground="#7894A3" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="BOTS PER MATCH" Style="{StaticResource SettingsSection}" Margin="0,18,0,0" />
                                            <TextBlock Text="Enter a number or range, such as 40-60. Leave blank for 99 bots. Matches are capped at 100 players."
                                                       Style="{StaticResource SettingsHint}" Margin="0,5,0,7" />
                                            <TextBox Style="{StaticResource GlassTextBox}"
                                                     Text="{Binding BotCountRange, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Bots per match" />
                                            <TextBlock Text="{Binding BotCountError}" Margin="0,5,0,0"
                                                       Foreground="{StaticResource DangerBrush}" FontSize="9.5"
                                                       TextWrapping="Wrap" />
                                            <CheckBox Style="{StaticResource DarkCheckBox}"
                                                      Content="Confirm edits on release" Margin="0,13,0,0"
                                                      IsChecked="{Binding EditOnRelease}"
                                                      AutomationProperties.Name="Confirm edits on release" />

                                            <Border Height="1" Background="#12FFFFFF" Margin="0,18,0,18" />

                                            <TextBlock Text="LAUNCH ARGUMENTS" Style="{StaticResource SettingsSection}" />
                                            <TextBlock Text="Extra command-line flags passed to the game when you press play."
                                                       Style="{StaticResource SettingsHint}" Margin="0,5,0,7" />
                                            <TextBox Style="{StaticResource GlassTextBox}"
                                                     Text="{Binding LaunchArguments, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Launch arguments" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Border Grid.Row="1" Height="40" VerticalAlignment="Bottom"
                                            IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00071420" Offset="0" />
                                                <GradientStop Color="#F2071420" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <Border Grid.Row="2" BorderBrush="#12FFFFFF" BorderThickness="0,1,0,0"
                                            Padding="22,11,22,15">
                                        <Grid>
                                            <TextBlock Text="Changes save automatically" FontSize="8.5"
                                                       Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center" />
                                            <Button Content="DONE" Style="{StaticResource PrimaryButton}" MinWidth="96"
                                                    HorizontalAlignment="Right" Command="{Binding CloseSettingsCommand}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
